{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "firestore.indexes.json",
      "server.ps1",
      "**/.*",
      "**/*.log",
      "**/*.exe",
      "**/node_modules/**",
      "**/functions/**",
      "**/*.md"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/career-clinic",
        "destination": "/career-clinic.html"
      },
      {
        "source": "/career-clinic/readiness-score",
        "destination": "/readiness-score.html"
      },
      {
        "source": "/career-clinic/placement-plan",
        "destination": "/placement-plan.html"
      },
      {
        "source": "/readiness-gap",
        "destination": "/readiness-gap.html"
      },
      {
        "source": "/framework",
        "destination": "/framework.html"
      },
      {
        "source": "/students",
        "destination": "/students.html"
      },
      {
        "source": "/institutions",
        "destination": "/institutions.html"
      },
      {
        "source": "/leadership",
        "destination": "/leadership.html"
      },
      {
        "source": "/experience",
        "destination": "/experience.html"
      },
      {
        "source": "/contact",
        "destination": "/contact.html"
      },
      {
        "source": "/readiness-score",
        "destination": "/readiness-score.html"
      },
      {
        "source": "/placement-plan",
        "destination": "/placement-plan.html"
      },
      {
        "source": "/ResumeFitScore/style.css",
        "destination": "/career-clinic-resume-checker/style.css"
      },
      {
        "source": "/ResumeFitScore/script.js",
        "destination": "/career-clinic-resume-checker/script.js"
      },
      {
        "source": "/ResumeFitScore/repository-service.js",
        "destination": "/career-clinic-resume-checker/repository-service.js"
      },
      {
        "source": "/ResumeFitScore/jd-database.js",
        "destination": "/career-clinic-resume-checker/jd-database.js"
      },
      {
        "source": "/ResumeFitScore/logo.png",
        "destination": "/career-clinic-resume-checker/logo.png"
      },
      {
        "source": "/ResumeFitScore/auth-guard.js",
        "destination": "/career-clinic-resume-checker/auth-guard.js"
      },
      {
        "source": "/ResumeFitScore/brand-logo.png",
        "destination": "/career-clinic-resume-checker/brand-logo.png"
      },
      {
        "source": "/ResumeFitScore/brand-emblem.png",
        "destination": "/career-clinic-resume-checker/brand-emblem.png"
      },
      {
        "source": "/ResumeFitScore/favicon.png",
        "destination": "/career-clinic-resume-checker/favicon.png"
      },
      {
        "source": "/ResumeFitScore",
        "destination": "/career-clinic-resume-checker/index.html"
      },
      {
        "source": "/ResumeFitScore/**",
        "destination": "/career-clinic-resume-checker/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(css|js|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/resumefitscore",
        "destination": "/ResumeFitScore",
        "type": 301
      },
      {
        "source": "/resumefitscore/**",
        "destination": "/ResumeFitScore",
        "type": 301
      }
    ],
    "site": "my-career-company"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}