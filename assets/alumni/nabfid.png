<script>
document.addEventListener('DOMContentLoaded', function () {
    var acceptButton = document.getElementById('catapultCookie');
    var cookieBar = document.getElementById('catapult-cookie-bar');

    if (!acceptButton || !cookieBar) {
        return;
    }

    acceptButton.addEventListener('click', function (event) {
        event.preventDefault();

        acceptButton.disabled = true;

        fetch('https://nabfid.org/page/accept_cookie', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }
            return response.json();
        })
        .then(function (result) {
            if (result.success === true) {
                cookieBar.style.display = 'none';
                return;
            }

            throw new Error('Cookie consent was not saved.');
        })
        .catch(function (error) {
            console.error('Cookie consent failed:', error);
            acceptButton.disabled = false;
            alert('Unable to save cookie consent. Please try again.');
        });
    });
});
</script>



