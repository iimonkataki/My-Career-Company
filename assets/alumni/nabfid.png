<script>
  const targetDiv = document.getElementById("popup");
  const btn = document.getElementById("close");
  
  if (btn && targetDiv) {
    btn.onclick = function () {
      if (targetDiv.style.display !== "none") {
        targetDiv.style.display = "none";
      } else {
        targetDiv.style.display = "block";
      }
    };
  }
</script>


<script>
  $(document).ready(function () {
    $('.gov-portal a.new-window').on('click', function (e) {
      e.preventDefault(); // Stop default link behavior
      const url = $(this).attr('href');

      // Show confirmation dialog
      if (confirm('You are being redirected to an external website. Please note that NaBFID is not responsible for the content and privacy policies of external websites.')) {
        window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
      }
    });
  });
</script>

<script>
  function isExternal(url) {
    try {
      const linkURL = new URL(url, location.href);
      const currentHost = location.hostname.replace(/^www\./, '');
      const targetHost = linkURL.hostname.replace(/^www\./, '');
      return currentHost !== targetHost;
    } catch (e) {
      return false;
    }
  }

  document.addEventListener("click", function (event) {
    const target = event.target.closest("a");
    if (!target || !target.href) return;

    const href = target.getAttribute("href")?.trim();

    // Skip non-navigational links
    if (
      href === "#" ||
      href.toLowerCase().startsWith("javascript:void") ||
      href === "" ||
      href === null
    ) {
      return;
    }

    // Ignore special clicks (new tab, middle click, etc.)
    if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey) return;

    // Exclude .gov-portal a.new-window
    if (target.matches(".gov-portal a.new-window, .gov-portal a.new-window *")) {
      return; // allow default behavior
    }

    if (isExternal(target.href)) {
      const message = "You are being redirected to an external website. Please note that NaBFID is not responsible for the content and privacy policies of external websites.";
      event.preventDefault();

      if (confirm(message)) {
        window.open(target.href, '_blank', 'noopener,noreferrer');
      }
    }
  });
</script>


