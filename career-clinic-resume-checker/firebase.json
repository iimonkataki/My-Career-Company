{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "cloudflared.exe",
      "*.md"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/ResumeFitScore",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/ResumeFitScore",
        "destination": "/index.html"
      },
      {
        "source": "/ResumeFitScore/**",
        "destination": "/index.html"
      }
    ],
    "site": "my-career-company"
  }
}