rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Institutional lead submissions from 'Book an Institutional Pilot' form
    match /institutional_leads/{leadId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.institution is string;
      allow read: if true;
      allow update, delete: if false;
    }

    // Strictly verify that the user is one of the 4 co-founders
    function isCoFounder() {
      return request.auth != null && (
        request.auth.token.email.lower() in [
          'upam.patra@gmail.com',
          'iimonkataki@mycareercompany.com',
          'ibonkataki@mycareercompany.com',
          'anirbanroy@mycareercompany.com',
          'anirbanroy@mycareercompanny.com'
        ]
      );
    }

    // Repository collection for saved candidate resumes, JDs, and diagnostic reports:
    match /resume_assessments/{assessmentId} {
      allow read, update, delete: if isCoFounder();
      allow create: if request.auth != null;
    }

    // Dedicated unique resumes collection:
    match /unique_resumes/{resumeId} {
      allow read, update, delete: if isCoFounder();
      allow create: if request.auth != null;
    }

    // Dedicated unique job descriptions collection:
    match /unique_job_descriptions/{jdId} {
      allow read, update, delete: if isCoFounder();
      allow create: if request.auth != null;
    }

    // Dynamic allowed users / candidate access list:
    match /allowed_users/{userId} {
      allow read: if request.auth != null;
      allow write: if isCoFounder();
    }

    // Default: require co-founder credentials
    match /{document=**} {
      allow read, write: if isCoFounder();
    }
  }
}
