rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Institutional lead submissions from 'Book an Institutional Pilot' form
    match /institutional_leads/{leadId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.institution is string;
      allow read: if true;
      allow update, delete: if false;
    }

    // Strictly verify that the user is one of the 4 co-founders
    function isCoFounder() {
      return request.auth != null && (
        request.auth.token.email.lower() in [
          'upam.patra@gmail.com',
          'iimonkataki@mycareercompany.com',
          'ibonkataki@mycareercompany.com',
          'anirbanroy@mycareercompany.com',
          'anirbanroy@mycareercompanny.com'
        ]
      );
    }

    // Repository collection for saved candidate resumes, JDs, and diagnostic reports:
    match /resume_assessments/{assessmentId} {
      allow read, update, delete: if isCoFounder();
      allow create: if request.auth != null;
    }

    // Dedicated unique resumes collection:
    match /unique_resumes/{resumeId} {
      allow read, update, delete: if isCoFounder();
      allow create: if request.auth != null;
    }

    // Dedicated unique job descriptions collection:
    match /unique_job_descriptions/{jdId} {
      allow read, update, delete: if isCoFounder();
      allow create: if request.auth != null;
    }

    // Dynamic allowed users / candidate access list:
    match /allowed_users/{userId} {
      allow read: if request.auth != null;
      allow write: if isCoFounder();
    }

    // Dynamic allowed users for Get Referred portal:
    match /referral_allowed_users/{userId} {
      // v3: each account may read only its own access record (it now also lists every POC); co-founders read all.
      allow get: if request.auth != null && (isCoFounder() || request.auth.token.email.lower() == userId);
      allow list, write: if isCoFounder();
    }

    // Automated Email Dispatch (Firebase Trigger Email extension):
    match /mail/{mailId} {
      allow create, read: if isCoFounder();
    }
    match /email_notifications/{noteId} {
      allow create, read: if isCoFounder();
    }

// ===== My Career Company · Get Referred portal · Firestore rules (v2.0, free Spark plan) =====
// ADD these lines INSIDE your existing:   match /databases/{database}/documents { ... }
// Do NOT delete your existing rules. Rules for the same path combine with OR, so this is safe to add.
// If you change the admin list, change it in firebase-config.js and apps-script/ReferralMailer.gs too.
// No Cloud Storage rules are needed: resumes are stored in Firestore (collection referral_files).

    function isReferralAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'anirbanroy@mycareercompany.com',
          'ibonkataki@mycareercompany.com',
          'iimonkataki@mycareercompany.com',
          'upam.patra@gmail.com'
        ];
    }

    function isOptionalString(d, key, maxLen) {
      return !(key in d) || (d[key] is string && d[key].size() <= maxLen);
    }

    // File description stored on the request. Resume max 2 MB, cover letter max 1 MB, at most 3 pieces.
    function isFileMeta(m, maxBytes) {
      return m is map
        && m.keys().hasOnly(['name', 'size', 'type', 'chunks'])
        && m.name is string && m.name.size() <= 200
        && m.size is int && m.size > 0 && m.size <= maxBytes
        && m.type in ['application/pdf', 'application/msword',
                      'application/vnd.openxmlformats-officedocument.wordprocessingml.document']
        && m.chunks is int && m.chunks >= 1 && m.chunks <= 3;
    }

    function isValidReferralRequest(d) {
      return d.keys().hasOnly(['fullName', 'email', 'phone', 'company', 'companySlug', 'jobId', 'jobTitle',
                               'recommendationNote', 'coverLetterText', 'coverLetterFile', 'resume',
                               'portalUrl', 'consent', 'source', 'status', 'submittedAt'])
        && d.keys().hasAll(['fullName', 'email', 'phone', 'company', 'companySlug', 'jobId',
                            'recommendationNote', 'resume', 'consent', 'status', 'submittedAt'])
        && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 100
        && d.email is string && d.email.size() <= 254 && d.email.matches('[^@\\s]+@[^@\\s]+[.][^@\\s]{2,}')
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 20
        && d.company is string && d.company.size() >= 1 && d.company.size() <= 120
        && d.companySlug is string && d.companySlug.size() >= 1 && d.companySlug.size() <= 120
        && d.jobId is string && d.jobId.size() >= 1 && d.jobId.size() <= 100
        && d.recommendationNote is string && d.recommendationNote.size() >= 40 && d.recommendationNote.size() <= 1500
        && isOptionalString(d, 'jobTitle', 150)
        && isOptionalString(d, 'coverLetterText', 6000)
        && isOptionalString(d, 'portalUrl', 500)
        && isOptionalString(d, 'source', 40)
        && isFileMeta(d.resume, 2097152)
        && (!('coverLetterFile' in d) || isFileMeta(d.coverLetterFile, 1048576))
        && d.consent == true
        && d.status == 'new'
        && d.submittedAt == request.time;
    }

    // One piece of an uploaded file. It can only be written in the SAME batch that creates its request
    // (getAfter + submittedAt == request.time), and only up to the number of pieces the request declares.
    function isValidReferralFile(fileId, f) {
      return f.keys().hasOnly(['requestId', 'kind', 'index', 'data'])
        && f.requestId is string && f.requestId.matches('[A-Za-z0-9]{10,40}')
        && f.kind in ['resume', 'cover-letter']
        && f.index is int && f.index >= 0 && f.index <= 2
        && fileId == f.requestId + '_' + f.kind + '_' + string(f.index)
        && f.data is string && f.data.size() > 0 && f.data.size() <= 950000
        && belongsToRequestInThisBatch(f);
    }

    function belongsToRequestInThisBatch(f) {
      return getAfter(/databases/$(database)/documents/referral_requests/$(f.requestId)).data.submittedAt == request.time
        && ((f.kind == 'resume'
              && f.index < getAfter(/databases/$(database)/documents/referral_requests/$(f.requestId)).data.resume.chunks)
            || (f.kind == 'cover-letter'
              && f.index < getAfter(/databases/$(database)/documents/referral_requests/$(f.requestId)).data.coverLetterFile.chunks));
    }

    // Visitors can only CREATE a request. Only admins can read, update or delete.
    match /referral_requests/{requestId} {
      allow create: if isValidReferralRequest(request.resource.data);
      allow read, update, delete: if isReferralAdmin();
    }

    // Resume and cover letter pieces. Visitors create (with their request); only admins read or delete.
    match /referral_files/{fileId} {
      allow create: if isValidReferralFile(fileId, request.resource.data);
      allow read, delete: if isReferralAdmin();
    }

    // Company list shown on the public page (names, job portal links, POC counts). No personal data.
    match /referral_public/{docId} {
      allow read: if true;
      allow write: if isReferralAdmin();
    }

    // POC names, phones, emails. Admins only.
    match /referral_private/{docId} {
      allow read, write: if isReferralAdmin();
    }
// ===== end Get Referred block =====

// ===== Get Referred v3 · Status of Referrals, POC accounts, proof uploads, confirmation emails =====
// Uses the existing referral_allowed_users/{email} documents for access, with two new fields:
//   getReferredAccess (missing = true for accounts granted before v3) and referAndEarnAccess (missing = false).
// Alias documents (isAlias, primaryEmail) let a POC sign in with another Google email.

    function grSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function grEmail() { return request.auth.token.email.lower(); }
    function grAccPath() { return /databases/$(database)/documents/referral_allowed_users/$(grEmail()); }
    function grHasAcc() { return grSignedIn() && exists(grAccPath()); }
    function grAcc() { return get(grAccPath()).data; }
    function grPrimary() { return grAcc().get('primaryEmail', grEmail()); }
    function grCanGR() { return grHasAcc() && grAcc().get('getReferredAccess', true) == true; }
    function grCanRE() { return grHasAcc() && grAcc().get('referAndEarnAccess', false) == true; }
    function grReqAfter(id) { return getAfter(/databases/$(database)/documents/referral_requests/$(id)).data; }
    function grAsgPath(id) { return /databases/$(database)/documents/poc_assignments/$(id); }

    // What the candidate sees. Created by the visitor in the SAME batch as the request; admins update it.
    match /candidate_status/{rid} {
      allow create: if request.resource.data.keys().hasOnly(['requestId', 'candidateEmail', 'candidateName', 'company',
                         'jobId', 'jobTitle', 'submittedAt', 'sharedWithMcc', 'mccSharedWithPoc', 'pocReferred'])
        && request.resource.data.requestId == rid
        && request.resource.data.sharedWithMcc == true
        && request.resource.data.mccSharedWithPoc == false
        && request.resource.data.pocReferred == false
        && request.resource.data.submittedAt == request.time
        && request.resource.data.candidateName is string && request.resource.data.candidateName.size() <= 100
        && request.resource.data.company is string && request.resource.data.company.size() <= 120
        && request.resource.data.jobId is string && request.resource.data.jobId.size() <= 100
        && isOptionalString(request.resource.data, 'jobTitle', 150)
        && grReqAfter(rid).submittedAt == request.time
        && request.resource.data.candidateEmail == grReqAfter(rid).email.lower();
      allow create, update, delete: if isReferralAdmin();
      allow get, list: if isReferralAdmin()
        || (grCanGR() && resource.data.candidateEmail == grPrimary());
      // A POC may only flip pocReferred, in the same batch that marks their own assignment referred.
      allow update: if grCanRE()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pocReferred', 'pocReferredAt'])
        && request.resource.data.pocReferred == true
        && request.resource.data.pocReferredAt == request.time
        && get(grAsgPath(rid + '__' + grPrimary())).data.pocEmail == grPrimary()
        && getAfter(grAsgPath(rid + '__' + grPrimary())).data.referred == true;
    }

    // What the POC sees: one document per request per POC, id = {requestId}__{pocEmail}.
    match /poc_assignments/{aid} {
      allow create, delete: if isReferralAdmin();
      allow get, list: if isReferralAdmin()
        || (grCanRE() && resource.data.pocEmail == grPrimary());
      allow update: if isReferralAdmin() || (grCanRE()
        && resource.data.pocEmail == grPrimary()
        && resource.data.referred != true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['referred', 'referredAt', 'proofPieces', 'proofName', 'proofType', 'proofSize'])
        && request.resource.data.referred == true
        && request.resource.data.referredAt == request.time
        && request.resource.data.proofPieces is int
        && request.resource.data.proofPieces >= 0 && request.resource.data.proofPieces <= 3
        && isOptionalString(request.resource.data, 'proofName', 200)
        && isOptionalString(request.resource.data, 'proofType', 60));
    }

    // Optional proof of referral (PDF or image), stored as base64 pieces like resumes. Admins read it.
    match /poc_proofs/{pid} {
      allow get, list, delete: if isReferralAdmin();
      allow create: if grCanRE()
        && request.resource.data.keys().hasOnly(['assignmentId', 'index', 'data'])
        && request.resource.data.index is int
        && request.resource.data.index >= 0 && request.resource.data.index <= 2
        && pid == request.resource.data.assignmentId + '_' + string(request.resource.data.index)
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 950000
        && getAfter(grAsgPath(request.resource.data.assignmentId)).data.pocEmail == grPrimary()
        && getAfter(grAsgPath(request.resource.data.assignmentId)).data.referredAt == request.time
        && request.resource.data.index < getAfter(grAsgPath(request.resource.data.assignmentId)).data.proofPieces;
    }

    // Lets the Apps Script mailer read who to send the "we received your request" email to.
    // Created with the request; publicly readable by id for 30 minutes only, then admins only.
    match /referral_confirmations/{rid} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'firstName', 'company', 'jobId', 'jobTitle', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.firstName is string && request.resource.data.firstName.size() <= 60
        && isOptionalString(request.resource.data, 'jobTitle', 150)
        && grReqAfter(rid).submittedAt == request.time
        && request.resource.data.email == grReqAfter(rid).email.lower()
        && request.resource.data.company == grReqAfter(rid).company
        && request.resource.data.jobId == grReqAfter(rid).jobId;
      allow get: if isReferralAdmin()
        || resource.data.createdAt > request.time - duration.value(30, 'm');
      allow list, update, delete: if isReferralAdmin();
    }
// ===== end Get Referred v3 block =====

    // Default: require co-founder credentials
    match /{document=**} {
      allow read, write: if isCoFounder();
    }
  }
}
